{
 "doctype": "DocType",
 "name": "AlphaX Lead Initiation",
 "module": "AlphaX CRM",
 "custom": 0,
 "istable": 0,
 "editable_grid": 0,
 "engine": "InnoDB",
 "autoname": "naming_series:",
 "sort_field": "creation",
 "sort_order": "DESC",
 "track_changes": 1,
 "description": "Audit trail for every inbound Lead-capture attempt through a webhook-driven channel (website form, Meta/Google lead ads, WhatsApp) \u2014 the two things that previously created Leads with no visible record: alphax_crm.api.lead_intake.capture() and the WhatsApp handler's own lead resolution. Smart Import and manual entry already have their own visibility (import summaries, standard doc metadata) so aren't logged here.",
 "field_order": [
  "naming_series",
  "channel",
  "status",
  "column_break_head",
  "lead",
  "received_at",
  "contact_section",
  "contact_identifier",
  "consent_given",
  "column_break_contact",
  "error",
  "payload_section",
  "raw_payload"
 ],
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "INIT-.YYYY.-",
   "hidden": 1
  },
  {
   "fieldname": "channel",
   "fieldtype": "Select",
   "label": "Channel",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "options": "Website\nMeta Ads\nGoogle Ads\nWhatsApp\nAPI\nOther",
   "description": "Which integration received this, not marketing attribution -- that's the Lead's own Source field."
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "default": "Success",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "options": "Success\nDuplicate\nFailed"
  },
  {
   "fieldname": "column_break_head",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "lead",
   "fieldtype": "Link",
   "label": "Lead",
   "options": "Lead",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "received_at",
   "fieldtype": "Datetime",
   "label": "Received At",
   "default": "now",
   "read_only": 1
  },
  {
   "fieldname": "contact_section",
   "fieldtype": "Section Break",
   "label": "Contact"
  },
  {
   "fieldname": "contact_identifier",
   "fieldtype": "Data",
   "label": "Contact Identifier",
   "description": "Whatever email, phone, or WhatsApp ID identified this person in the raw payload \u2014 kept even on failure, for follow-up."
  },
  {
   "fieldname": "consent_given",
   "fieldtype": "Check",
   "label": "Consent Given",
   "read_only": 1
  },
  {
   "fieldname": "column_break_contact",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "error",
   "fieldtype": "Small Text",
   "label": "Error",
   "read_only": 1,
   "depends_on": "eval:doc.status==\"Failed\""
  },
  {
   "fieldname": "payload_section",
   "fieldtype": "Section Break",
   "label": "Raw Payload",
   "collapsible": 1
  },
  {
   "fieldname": "raw_payload",
   "fieldtype": "Code",
   "label": "Raw Payload",
   "options": "JSON",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "share": 1
  },
  {
   "role": "Sales Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Sales User",
   "read": 1
  }
 ],
 "links": [],
 "actions": [],
 "states": []
}