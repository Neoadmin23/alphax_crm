 "fields": [
  {"fieldname": "scoring_section", "fieldtype": "Section Break", "label": "Lead Scoring"},
  {"fieldname": "scoring_enabled", "fieldtype": "Check", "label": "Enable Lead Scoring", "default": "1"},
  {"fieldname": "auto_opportunity_enabled", "fieldtype": "Check", "label": "Auto-create Opportunity for Hot Leads", "default": "1"},
  {"fieldname": "auto_opportunity_threshold", "fieldtype": "Int", "label": "Auto-Opportunity Score Threshold", "default": "70"},
  {"fieldname": "engagement_points", "fieldtype": "Int", "label": "Points per Engagement", "default": "2"},
  {"fieldname": "engagement_cap", "fieldtype": "Int", "label": "Engagement Points Cap", "default": "20"},
  {"fieldname": "score_rules", "fieldtype": "Table", "label": "Score Rules", "options": "AlphaX Lead Score Rule"},

  {"fieldname": "dedup_section", "fieldtype": "Section Break", "label": "De-duplication"},
  {"fieldname": "dedup_enabled", "fieldtype": "Check", "label": "Enable De-duplication", "default": "1"},
  {"fieldname": "dedup_fields", "fieldtype": "Small Text", "label": "De-dup Fields (comma separated)", "default": "email_id,mobile_no,phone"},
  {"fieldname": "dedup_action", "fieldtype": "Select", "label": "On Duplicate", "options": "Warn\nBlock", "default": "Warn"},

  {"fieldname": "dq_section", "fieldtype": "Section Break", "label": "Data Quality Gate", "description": "Require selected fields to be filled and correct before a lead is qualified/converted \u2014 even non-mandatory fields."},
  {"fieldname": "data_quality_enabled", "fieldtype": "Check", "label": "Enable Data Quality Gate", "default": "1"},
  {"fieldname": "dq_enforce_on", "fieldtype": "Select", "label": "Enforce On", "options": "Qualify or Convert\nOn Save\nBoth", "default": "Qualify or Convert", "description": "When to enforce. 'Qualify or Convert' lets raw leads be captured but blocks incomplete data when moving forward."},
  {"fieldname": "dq_block_incomplete", "fieldtype": "Check", "label": "Block if Incomplete", "default": "1", "description": "If off, incomplete data only warns instead of blocking."},
  {"fieldname": "dq_skip_for_intake", "fieldtype": "Check", "label": "Skip for Auto-captured Leads", "default": "1", "description": "Do not gate leads created by the intake / WhatsApp webhooks on capture."},
  {"fieldname": "dq_min_completeness", "fieldtype": "Int", "label": "Minimum Completeness %", "default": "0", "description": "0 = no percentage gate. Otherwise the required-field completeness must reach this %."},
  {"fieldname": "dq_col", "fieldtype": "Column Break"},
  {"fieldname": "dq_rules", "fieldtype": "Table", "label": "Field Rules", "options": "AlphaX Data Quality Rule"},

  {"fieldname": "prospect_section", "fieldtype": "Section Break", "label": "Prospect \u2192 Lead"},
  {"fieldname": "prospect_autoconvert", "fieldtype": "Check", "label": "Auto-create Lead when Prospect is Interested", "default": "1", "description": "When a Prospect is set to a status whose behavior is 'Convert to Lead', a Lead is created automatically with the same owner."},
  {"fieldname": "prospect_review_required", "fieldtype": "Check", "label": "Send Created Lead for Review", "default": "1", "description": "Auto-created Leads start at 'Pending Review'. If off, they start 'Approved'."},
  {"fieldname": "prospect_convert_target", "fieldtype": "Select", "label": "Convert Prospect To", "options": "Lead (direct)\nSmart Lead then Lead", "default": "Lead (direct)", "description": "Direct: create an ERPNext Lead immediately. Smart Lead: create an AlphaX Smart Lead for structured data entry that maps into the ERPNext Lead on submit (when the Smart Lead module is enabled)."},
  {"fieldname": "prospect_dimensions_enabled", "fieldtype": "Check", "label": "Enable Accounting Dimensions on Prospect", "default": "0",
   "description": "Off by default. Lead and Opportunity get every active Accounting Dimension unconditionally; Prospect is opt-in and separately restricted to the fields listed below, so turning this on doesn't dump every dimension onto the calling-list form."},
  {"fieldname": "prospect_dimension_fields", "fieldtype": "Small Text", "label": "Prospect Dimension Fields", "default": "cost_center",
   "depends_on": "eval:doc.prospect_dimensions_enabled",
   "description": "Comma-separated dimension fieldnames to show on Prospect (a subset of what's active site-wide). Default is Cost Center only. Fieldnames come from Setup > Accounting Dimension (e.g. cost_center, department, business_division, employee_cost_center)."},

  {"fieldname": "activity_monitor_section", "fieldtype": "Section Break", "label": "Activity Monitor", "description": "Track last activity (who / what / when) and idle time on open leads."},
  {"fieldname": "activity_monitor_enabled", "fieldtype": "Check", "label": "Enable Activity Monitor", "default": "1"},
  {"fieldname": "default_idle_threshold_days", "fieldtype": "Int", "label": "Default Idle Threshold (days)", "default": "3", "description": "Used when a monitored status has no threshold of its own."},
  {"fieldname": "capture_status_change", "fieldtype": "Check", "label": "Count Status Change as Activity", "default": "1"},
  {"fieldname": "am_col", "fieldtype": "Column Break"},
  {"fieldname": "monitored_statuses", "fieldtype": "Table", "label": "Monitored Statuses", "options": "AlphaX Monitored Status", "description": "Which lead statuses are monitored for idle time. Mark exactly one as Default (used as the on-screen report's default filter)."},

  {"fieldname": "dimensions_section", "fieldtype": "Section Break", "label": "Accounting Dimensions"},
  {"fieldname": "sync_accounting_dimensions", "fieldtype": "Check", "label": "Add Active Accounting Dimensions to CRM Documents", "default": "1", "description": "Auto-adds Link fields (Cost Center, Department, and any active Accounting Dimension such as Business Unit) to Lead, Prospect and Opportunity, matching whatever is activated in ERPNext."},

  {"fieldname": "report_fields_section", "fieldtype": "Section Break", "label": "Report Fields & Filters", "description": "Add extra fields (e.g. dimensions like Cost Center / Business Unit, or Territory) to show as columns and be available as filters in the Activity Monitor reports \u2014 no code needed."},
  {"fieldname": "monitor_fields", "fieldtype": "Table", "label": "Extra Report Fields", "options": "AlphaX Monitor Field"},

  {"fieldname": "smart_lead_section", "fieldtype": "Section Break", "label": "Smart Lead \u2192 ERPNext Lead", "description": "Smart Lead is the clean entry screen; on save it maps into the ERPNext Lead using the field map below."},
  {"fieldname": "smart_lead_autocreate", "fieldtype": "Check", "label": "Create / update Lead automatically on save", "default": "1"},
  {"fieldname": "smart_lead_map", "fieldtype": "Table", "label": "Field Map (Smart Lead \u2192 Lead)", "options": "AlphaX Smart Lead Map"},

  {"fieldname": "na_api_section", "fieldtype": "Section Break", "label": "Saudi National Address (SPL)", "collapsible": 1, "description": "Optional. Credentials for live National Address lookup from Saudi Post (SPL / address.gov.sa)."},
