# ---- public address (DNS A record -> this server) and access key -----------------------------
AI_DOMAIN=ai.your-company.sa
# long random key: openssl rand -hex 32   (paste the same value into AlphaX CRM Settings > API Key)
AI_API_KEY=change-me
ACME_EMAIL=it@your-company.sa

# ---- engine: start with  docker compose --profile ollama up -d   or   --profile vllm ------------
# Caddy must forward to the engine you start:
UPSTREAM=ollama:11434
# UPSTREAM=vllm:8000

# ---- Ollama --------------------------------------------------------------------------------------
OLLAMA_MODEL=qwen3.8:27b
# optional small model for AlphaX "Fast Model" (spell check, translation)
OLLAMA_FAST_MODEL=
OLLAMA_NUM_PARALLEL=4
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_KEEP_ALIVE=24h

# ---- vLLM ----------------------------------------------------------------------------------------
VLLM_MODEL=Qwen/Qwen3.8-27B
VLLM_SERVED_NAME=qwen3.8-27b
VLLM_MAX_LEN=32768
VLLM_GPU_UTIL=0.90
VLLM_TP=1
VLLM_TOOL_PARSER=qwen3_coder
HF_TOKEN=
